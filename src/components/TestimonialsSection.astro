---
import TestimonialCard from "./TestimonialCard.astro";

interface Testimonial {
  quote: string;
  initials: string;
  name: string;
  role: string;
}
interface Props {
  eyebrow?: string;
  /** HTML allowed */
  title: string;
  testimonials: Testimonial[];
  glow?: "tl" | "tr" | "bl" | "br";
}
const {
  eyebrow = "Testimonianze",
  title,
  testimonials,
  glow = "tl"
} = Astro.props;
---
<section class:list={["testi", `glow-${glow}`]}>
  <div class="wrap">
    <div class="section-head">
      <div>
        <div class="eyebrow reveal">{eyebrow}</div>
        <h2 class="reveal" set:html={title}></h2>
      </div>
    </div>
    <div class="testi-grid">
      {testimonials.map((t, i) => (
        <TestimonialCard {...t} delay={i} />
      ))}
    </div>
  </div>
</section>
