---
interface BreadcrumbItem {
  label: string;
  href?: string;
}
interface Props {
  items: BreadcrumbItem[];
}
const { items } = Astro.props;
---
<div class="crumb">
  {items.map((item, i) => (
    <>
      {item.href ? <a href={item.href}>{item.label}</a> : item.label}
      {i < items.length - 1 && <span>/</span>}
    </>
  ))}
</div>
