---
interface FeatureRow {
  label: string;
  /** Valore highlight in rosso */
  value: string;
}
interface Props {
  eyebrow: string;
  /** HTML allowed */
  title: string;
  paragraph: string;
  rows?: FeatureRow[];
  image: string;
  imageAlt?: string;
  cta?: { label: string; href: string };
  reverse?: boolean;
  glow?: "tl" | "tr" | "bl" | "br";
}
const {
  eyebrow,
  title,
  paragraph,
  rows = [],
  image,
  imageAlt = "",
  cta,
  reverse = false,
  glow
} = Astro.props;
---
<section class:list={["section", "feature", reverse && "feature--reverse", glow && `glow-${glow}`]}>
  <div class="wrap">
    <div class="feature-grid">
      <div class="feature-img reveal">
        <img src={image} alt={imageAlt} loading="lazy">
      </div>
      <div class="feature-info reveal" data-delay="1">
        <div class="eyebrow">{eyebrow}</div>
        <h2 set:html={title}></h2>
        <p>{paragraph}</p>
        {rows.length > 0 && (
          <ul class="feature-list">
            {rows.map((r) => (
              <li><span>{r.label}</span><span class="ex">{r.value}</span></li>
            ))}
          </ul>
        )}
        {cta && <a href={cta.href} class="btn">{cta.label}</a>}
      </div>
    </div>
  </div>
</section>
