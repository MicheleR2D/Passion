---
// Footer globale con sede + link grid
---
<footer id="contatti" class="glow-tr">
  <div class="foot-sede">
    <div class="wrap">
      <div class="foot-sede-grid">
        <div class="foot-sede-img reveal">
          <img src="https://images.unsplash.com/photo-1540474211261-0dbd0a3b34f5?w=1600&q=80&auto=format&fit=crop" alt="Sede Passion Fitness Tuscolana" loading="lazy">
          <div class="foot-pin"></div>
        </div>
        <div class="foot-sede-info reveal" data-delay="1">
          <div class="eyebrow">Sede</div>
          <h2>Via Tuscolana <em>1052</em>, Roma.</h2>
          <div class="foot-addr">Cinecittà · Don Bosco · San Policarpo<br>Aperta ogni giorno · 5:00 — 24:00</div>
          <div class="foot-tags">
            <span>Metro A</span><span>Parcheggio</span><span>Docce &amp; Spogliatoi</span><span>Bar</span><span>WiFi</span>
          </div>
          <a href="https://maps.google.com/?q=Via+Tuscolana+1052+Roma" target="_blank" rel="noopener" class="btn">Indicazioni stradali →</a>
        </div>
      </div>
    </div>
  </div>
  <div class="foot-links">
    <div class="wrap">
      <div class="foot-grid">
        <div class="foot-brand">
          <div class="logo">
            <svg class="logo-mark"><use href="#pf-logo"/></svg>
            <span class="logo-text">PASSION FITNESS<small>Tuscolana · Roma</small></span>
          </div>
          <p>Via Tuscolana 1052, Roma. La palestra di quartiere delle zone Tuscolana, Cinecittà, Don Bosco e San Policarpo. Da trent'anni.</p>
        </div>
        <div>
          <h4>La Palestra</h4>
          <ul>
            <li><a href="/#la-palestra">Chi siamo</a></li>
            <li><a href="/corsi">I corsi</a></li>
            <li><a href="/orari">Orari</a></li>
            <li><a href="/abbonamenti">Abbonamenti</a></li>
          </ul>
        </div>
        <div>
          <h4>Corsi &amp; Servizi</h4>
          <ul>
            <li><a href="/sala-pesi">Sala Pesi</a></li>
            <li><a href="/corsi-fitness">Corsi Fitness</a></li>
            <li><a href="/pilates-reformer">Reformer Pilates</a></li>
            <li><a href="/crossfit">CrossFit</a></li>
            <li><a href="/hyrox">Hyrox</a></li>
            <li><a href="/personal-training">Personal Training</a></li>
          </ul>
        </div>
        <div>
          <h4>Social</h4>
          <ul>
            <li><a href="https://instagram.com/passionfitnesstuscolana" target="_blank" rel="noopener">Instagram</a></li>
            <li><a href="#" target="_blank" rel="noopener">Facebook</a></li>
            <li><a href="#" target="_blank" rel="noopener">YouTube</a></li>
            <li><a href="#" target="_blank" rel="noopener">TikTok</a></li>
          </ul>
        </div>
      </div>
      <div class="foot-bottom">
        <div>© {new Date().getFullYear()} Passion Fitness · P.IVA XXXXXXX</div>
        <div>Privacy · Cookie · Termini</div>
      </div>
    </div>
  </div>
</footer>
